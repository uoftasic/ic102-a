# IC102-A: the versions Tiny Tapeout's precheck uses, and the ones we install.
#
# Read on 2026-11-15 and 2026-11-16 from the sources named on each line.
# install.sh, check-tools.sh and precheck.sh all read this file, so a version
# changes in one place. tool_pins.md in the IC102 research notes has the full
# table and what to redo when Tiny Tapeout moves its tags.
#
# The analog template's workflows call the actions at one tag:
#   TinyTapeout/ttsky-analog-template 301590b, .github/workflows/gds.yaml
TT_TEMPLATE=TinyTapeout/ttsky-analog-template
TT_TEMPLATE_COMMIT=301590bc02ffeabc2bb176489de9db0818a4b958
TT_ACTION_TAG=ttsky26d
# What the tag pointed at when we read it (git ls-remote, 2026-11-15). Tags move.
TT_ACTION_COMMIT=395eedb3eeec3c2f4961c3b04ff2cf87f5525636

# precheck checks out tt-support-tools at `main` (tools-ref defaults to main at
# ttsky26d), so the precheck code is whatever main is on the day. This is the
# commit the runner checked out on 2026-11-16 (uoftasic/sentry run 43796948508,
# "git log -1 --format=%H" in the Build GDS step).
TT_SUPPORT_TOOLS_REPO=https://github.com/TinyTapeout/tt-support-tools
TT_SUPPORT_TOOLS_COMMIT=9d13ff3e3e6202090740110438c6a10c1d62ca0f

# precheck/action.yml at ttsky26d: PDK_VERSION for sky130A, installed with
# TinyTapeout/ciel-action@v1, whose default ciel_version is 3.2.0.
SKY130_PDK_COMMIT=0536d02d875c8f67dd7cca3902ac457e62f20005
CIEL_VERSION=3.2.0

# tt-support-tools precheck/default.nix: Magic from nixpkgs cee01fe2,
# KLayout from nixpkgs ffa10e26. The runner log shows the store paths
# magic-vlsi-8.3.568 and klayout-0.30.8 (ktm0228/ttsky26d-opamptrim run
# 43690321709) and prints "Magic 8.3 revision 568".
MAGIC_VERSION=8.3.568
# The tag is an annotated tag; this is the commit it points at (Oct 23, 2025).
MAGIC_TAG_COMMIT=0ac4d3a46554884c6e764556b63eb843574b4e14
KLAYOUT_VERSION=0.30.8
KLAYOUT_DEB_URL=https://www.klayout.org/downloads/Ubuntu-24/klayout_0.30.8-1_amd64.deb
KLAYOUT_DEB_SHA256=915ed837c0dc6318190e9151ce00407e028e34b2c60251965eafd255a94dffe3

# Magic needs the Tcl and Tk headers to build, and the workbench image has the
# libraries but not the headers. These are the Ubuntu 24.04 packages that match
# the image's libtcl8.6 8.6.14+dfsg-1build1 and libtk8.6 8.6.14-1build1.
TCL_DEV_DEB_URL=http://archive.ubuntu.com/ubuntu/pool/main/t/tcl8.6/tcl8.6-dev_8.6.14+dfsg-1build1_amd64.deb
TCL_DEV_DEB_SHA256=82160ed9f621f93b0c3001d86bec91844030c809812e1da73192bc0e0e269162
TK_DEV_DEB_URL=http://archive.ubuntu.com/ubuntu/pool/main/t/tk8.6/tk8.6-dev_8.6.14-1build1_amd64.deb
TK_DEV_DEB_SHA256=9d3e3ba2fbac896a330e717dd5e946fa4cf198051b74e2b5f24809261b05ac80

# setup-python '3.11' gave CPython 3.11.18 on the runner. The uv in the
# workbench (0.12.5) offers up to 3.11.16, which is close enough: the wheels
# are built for cp311 either way.
PYTHON_RUNNER=3.11.18
PYTHON_VERSION=3.11.16

# The pip klayout module precheck imports. precheck/requirements.txt allows any
# 0.30.x (>=0.30.8,<0.31.0), so the runner takes the newest one: 0.30.12 on
# 2026-11-02, 0.30.13 on 2026-11-15. requirements.txt pins what we saw last.
KLAYOUT_PY_VERSION=0.30.13

# What the workbench image ships (hpretl/iic-osic-tools:2026.08), for the
# comparison column in check-tools.
WB_MAGIC=8.3.681
WB_KLAYOUT=0.30.11
WB_SKY130_PDK_COMMIT=026824c7969ce6f4fc9678e6ca04b0a06a596c4b
